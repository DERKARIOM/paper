<?xml version="1.0" encoding="utf-8"?>
<!-- Round, slightly transparent background for floating scan controls (readable on dark and
     bright camera images). -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#33FFFFFF">
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/scan_control_bg" />
            <stroke android:width="1dp" android:color="@color/scan_control_stroke" />
        </shape>
    </item>
</ripple>
