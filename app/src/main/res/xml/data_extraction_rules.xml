<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ backup rules.
  Privacy (local-first): scanned documents, OCR text, thumbnails and the scan database are NEVER
  uploaded to the cloud backup. Only small preferences (settings) are backed up.
  Device-to-device transfer (direct, local) keeps the default behaviour so a user moving to a new
  phone keeps their documents.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="." />
    </cloud-backup>
</data-extraction-rules>
