<?xml version="1.0" encoding="utf-8"?>
<!--
  Auto Backup rules for Android 11 and lower (see data_extraction_rules.xml for Android 12+).
  Privacy (local-first): only preferences are backed up; documents, OCR data, caches and the scan
  database stay on the device.
-->
<full-backup-content>
    <include domain="sharedpref" path="." />
</full-backup-content>
