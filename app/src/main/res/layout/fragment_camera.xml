<?xml version="1.0" encoding="utf-8"?>
<!-- Scan screen: dark, edge-to-edge camera with floating controls and a fixed framing guide.
     The preview keeps the full 4:3 sensor image (FIT_CENTER) so the captured photo is exactly
     what the user sees; controls float over the preview or sit in the dark areas around it. -->
<androidx.constraintlayout.widget.ConstraintLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:id="@+id/camera_root"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/scan_background">

    <!-- Top bar: options · workflow position · zoom + flash (top margin = status bar inset) -->
    <FrameLayout
            android:id="@+id/camera_top_bar"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

        <ImageButton
                android:id="@+id/button_camera_options"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_gravity="start|center_vertical"
                android:background="@drawable/bg_scan_control"
                android:contentDescription="@string/btn_options"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_tune"
                app:tint="@color/scan_on_dark"
                app:tooltipText="@string/btn_options" />

        <!-- Workflow stepper: Camera → Crop → Export (step 1) -->
        <de.schliweb.makeacopy.ui.views.WorkflowStepperView
                android:id="@+id/workflow_stepper"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                app:currentStep="1" />

        <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end|center_vertical"
                android:gravity="center_vertical"
                android:orientation="horizontal">

            <!-- Zoom / lens -->
            <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/button_camera_zoom"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_scan_chip"
                    android:contentDescription="@string/camera_zoom_cd"
                    android:minWidth="56dp"
                    android:minHeight="44dp"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:text="@string/camera_zoom_ratio"
                    android:textAllCaps="false"
                    android:textColor="@color/scan_on_dark"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    app:tooltipText="@string/camera_zoom_cd" />

            <!-- Flash (hidden when the camera has no flash unit) -->
            <ImageButton
                    android:id="@+id/button_flash"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_scan_control"
                    android:contentDescription="@string/toggle_flashlight"
                    android:padding="10dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_flash_off"
                    app:tint="@color/scan_on_dark"
                    app:tooltipText="@string/toggle_flashlight" />
        </LinearLayout>
    </FrameLayout>

    <!-- Camera preview (full width, FIT_CENTER) -->
    <androidx.camera.view.PreviewView
            android:id="@+id/view_finder"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:focusable="false"
            android:clickable="false"
            android:importantForAccessibility="no"
            app:layout_constraintTop_toBottomOf="@id/camera_top_bar"
            app:layout_constraintBottom_toTopOf="@id/scan_button_container"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Fixed framing guide: A4 frame centered in the visible camera image -->
    <de.schliweb.makeacopy.ui.camera.ScanGuideOverlay
            android:id="@+id/scan_guide"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintTop_toTopOf="@id/view_finder"
            app:layout_constraintBottom_toBottomOf="@id/view_finder"
            app:layout_constraintStart_toStartOf="@id/view_finder"
            app:layout_constraintEnd_toEndOf="@id/view_finder" />

    <!-- Detected document outline (live corner detection) -->
    <de.schliweb.makeacopy.ui.camera.CameraCornersOverlay
            android:id="@+id/corner_overlay"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:clickable="false"
            android:focusable="false"
            app:layout_constraintTop_toTopOf="@id/view_finder"
            app:layout_constraintBottom_toBottomOf="@id/view_finder"
            app:layout_constraintStart_toStartOf="@id/view_finder"
            app:layout_constraintEnd_toEndOf="@id/view_finder" />

    <!-- Tap-to-focus indicator overlay -->
    <de.schliweb.makeacopy.ui.camera.FocusRingView
            android:id="@+id/focus_ring"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:clickable="false"
            android:focusable="false"
            android:importantForAccessibility="no"
            app:layout_constraintTop_toTopOf="@id/view_finder"
            app:layout_constraintBottom_toBottomOf="@id/view_finder"
            app:layout_constraintStart_toStartOf="@id/view_finder"
            app:layout_constraintEnd_toEndOf="@id/view_finder" />

    <!-- Captured image preview (legacy review mode) -->
    <ImageView
            android:id="@+id/captured_image"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:scaleType="fitCenter"
            android:contentDescription="@string/captured_image"
            android:visibility="gone"
            app:layout_constraintTop_toTopOf="@id/view_finder"
            app:layout_constraintBottom_toBottomOf="@id/view_finder"
            app:layout_constraintStart_toStartOf="@id/view_finder"
            app:layout_constraintEnd_toEndOf="@id/view_finder"/>

    <!-- Live focus-quality (sharpness) indicator: feature-flagged, hidden by default -->
    <de.schliweb.makeacopy.ui.camera.FocusQualityIndicatorView
            android:id="@+id/focus_quality_indicator"
            android:layout_width="72dp"
            android:layout_height="14dp"
            android:layout_marginStart="16dp"
            android:layout_marginTop="12dp"
            android:visibility="gone"
            android:contentDescription="@string/focus_quality_low"
            app:layout_constraintTop_toTopOf="@id/view_finder"
            app:layout_constraintStart_toStartOf="parent"/>

    <!-- Framing hint: short message in a translucent pill, just above the controls.
         Changes to "Document detected" when the live detection sees a well framed page. -->
    <TextView
            android:id="@+id/text_camera"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_scan_hint"
            android:drawablePadding="8dp"
            android:gravity="center"
            android:maxLines="2"
            android:minHeight="40dp"
            android:paddingStart="16dp"
            android:paddingTop="8dp"
            android:paddingEnd="16dp"
            android:paddingBottom="8dp"
            android:text="@string/scan_hint_place_document"
            android:textColor="@color/scan_on_dark"
            android:textSize="15sp"
            android:accessibilityHeading="true"
            android:accessibilityLiveRegion="polite"
            app:drawableStartCompat="@drawable/ic_scan_frame"
            app:layout_constraintWidth_max="360dp"
            app:layout_constrainedWidth="true"
            app:layout_constraintBottom_toBottomOf="@id/view_finder"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Manual focus control (optional feature, hidden by default) -->
    <LinearLayout
            android:id="@+id/focus_control"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@color/scan_hint_bg"
            android:paddingStart="16dp"
            android:paddingEnd="8dp"
            android:visibility="gone"
            app:layout_constraintBottom_toTopOf="@id/exposure_control"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

        <TextView
                android:id="@+id/focus_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/manual_focus_auto"
                android:textColor="@color/scan_on_dark"
                android:textSize="12sp"
                android:minWidth="56dp"
                android:gravity="center"/>

        <com.google.android.material.button.MaterialButton
                android:id="@+id/focus_af_button"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="48dp"
                android:checkable="true"
                android:text="@string/manual_focus_auto"
                android:textColor="@color/scan_on_dark"
                android:textSize="12sp"
                android:contentDescription="@string/manual_focus_af_button_cd"/>

        <com.google.android.material.slider.Slider
                android:id="@+id/focus_slider"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:valueFrom="1"
                android:valueTo="100"
                android:stepSize="1"
                app:labelBehavior="floating"
                android:contentDescription="@string/manual_focus_cd"/>

    </LinearLayout>

    <!-- Exposure compensation control (optional feature, hidden by default) -->
    <LinearLayout
            android:id="@+id/exposure_control"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@color/scan_hint_bg"
            android:paddingStart="16dp"
            android:paddingEnd="8dp"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="@id/view_finder"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

        <TextView
                android:id="@+id/exposure_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/exposure_compensation_cd"
                android:textColor="@color/scan_on_dark"
                android:textSize="12sp"
                android:minWidth="56dp"
                android:gravity="center"/>

        <com.google.android.material.slider.Slider
                android:id="@+id/exposure_slider"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:valueFrom="0"
                android:valueTo="1"
                android:stepSize="1"
                app:labelBehavior="floating"
                android:contentDescription="@string/exposure_compensation_cd"/>

    </LinearLayout>

    <!-- Bottom controls: gallery · capture (primary) · documents -->
    <LinearLayout
            android:id="@+id/scan_button_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:baselineAligned="false"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingTop="12dp"
            android:paddingBottom="8dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

        <!-- Gallery: import an existing image or PDF -->
        <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

            <ImageButton
                    android:id="@+id/button_pick_image"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:background="@drawable/bg_scan_control"
                    android:contentDescription="@string/pick_image_cd"
                    android:padding="14dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_image"
                    app:tint="@color/scan_on_dark"
                    app:tooltipText="@string/pick_image_cd" />

            <TextView
                    android:id="@+id/label_pick_image"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:importantForAccessibility="no"
                    android:text="@string/scan_label_gallery"
                    android:textColor="@color/scan_on_dark_secondary"
                    android:textSize="12sp" />
        </LinearLayout>

        <!-- Capture: the primary action -->
        <ImageButton
                android:id="@+id/button_scan"
                android:layout_width="76dp"
                android:layout_height="76dp"
                android:background="@drawable/bg_scan_shutter"
                android:contentDescription="@string/btn_scan"
                app:tooltipText="@string/btn_scan" />

        <!-- Documents: scans library (feature-flagged; hidden together with its label) -->
        <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

            <ImageButton
                    android:id="@+id/button_open_library_cam"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:background="@drawable/bg_scan_control"
                    android:contentDescription="@string/open_collections"
                    android:padding="14dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_library"
                    android:visibility="invisible"
                    app:tint="@color/scan_on_dark"
                    app:tooltipText="@string/open_collections" />

            <TextView
                    android:id="@+id/label_open_library"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:importantForAccessibility="no"
                    android:text="@string/scan_label_documents"
                    android:textColor="@color/scan_on_dark_secondary"
                    android:textSize="12sp"
                    android:visibility="invisible" />
        </LinearLayout>
    </LinearLayout>

    <!-- Review buttons (legacy review mode, hidden in the normal scan flow) -->
    <LinearLayout
            android:id="@+id/button_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal"
            android:padding="12dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="8dp"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

        <Button
                android:id="@+id/button_retake"
                style="@style/Widget.MakeACopy.Button.Tonal"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="12dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="@string/back"
                android:maxLines="1"
                android:ellipsize="end" />

        <Button
                android:id="@+id/button_confirm"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="@string/next"
                android:maxLines="1"
                android:ellipsize="end" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
